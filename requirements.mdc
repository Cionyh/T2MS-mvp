## 18. Database Schema Requirements

### 18.1 Core Tables

#### InstallJob
```prisma
model InstallJob {
  id                    String   @id @default(cuid())
  customerId            String
  platform              String
  installType           String   // "script" | "iframe"
  websiteUrls           String[] // Array of URLs
  accessMethod          String   // "temporary_login" | "admin_invite" | "instructions"
  accessCredentials     String?  // Encrypted JSON
  status                String   // Job status enum
  priority              Int      @default(0)
  assignedWorkerId      String?
  checklistCompleted    Boolean  @default(false)
  proofUploaded         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  // Relations
  customer              Customer @relation(fields: [customerId], references: [id])
  assignedWorker        Worker?  @relation(fields: [assignedWorkerId], references: [id])
  proofs                Proof[]
  payouts               WorkerPayout[]
}
```

#### Worker
```prisma
model Worker {
  id              String       @id @default(cuid())
  userId          String       @unique
  availability    String       @default("OFF_SHIFT") // "OFF_SHIFT" | "ON_SHIFT" | "PAUSED"
  maxActiveJobs   Int          @default(2)
  createdAt       DateTime     @default(now())
  // Relations
  user            User         @relation(fields: [userId], references: [id])
  assignedJobs    InstallJob[]
  payouts         WorkerPayout[]
  channelAssignments ChannelAssignment[]
}
```

#### WorkerPayout
```prisma
model WorkerPayout {
  id          String     @id @default(cuid())
  workerId    String
  jobId       String
  amount      Decimal
  status      String     // "EARNED" | "APPROVED" | "PAID"
  createdAt   DateTime   @default(now())
  paidAt      DateTime?
  // Relations
  worker      Worker     @relation(fields: [workerId], references: [id])
  job         InstallJob @relation(fields: [jobId], references: [id])
}
```

#### Proof
```prisma
model Proof {
  id          String     @id @default(cuid())
  jobId       String
  type        String     // "desktop" | "mobile" | "message"
  fileUrl     String
  fileSize    Int
  uploadedAt  DateTime   @default(now())
  // Relations
  job         InstallJob @relation(fields: [jobId], references: [id])
}
```

#### Business (Workspace)
```prisma
model Business {
  id              String      @id @default(cuid())
  ownerId         String
  name            String
  createdAt       DateTime    @default(now())
  // Relations
  owner           User        @relation(fields: [ownerId], references: [id])
  teamPages       TeamPage[]
  customers       Customer[]
  phoneNumbers    PhoneNumber[]
}
```

#### TeamPage (Channel)
```prisma
model TeamPage {
  id              String      @id @default(cuid())
  businessId      String
  name            String
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  // Relations
  business        Business    @relation(fields: [businessId], references: [id])
  assignedUsers   ChannelAssignment[]
  customers       Customer[]
  threads         Thread[]
  phoneNumbers    ChannelPhoneNumber[]
}
```

#### Customer
```prisma
model Customer {
  id                  String      @id @default(cuid())
  businessId          String
  phoneNumber         String
  assignedTeamPageId  String
  smsConsentConfirmedAt DateTime?
  createdAt           DateTime    @default(now())
  // Relations
  business            Business    @relation(fields: [businessId], references: [id])
  assignedTeamPage    TeamPage    @relation(fields: [assignedTeamPageId], references: [id])
  threads             Thread[]
  installJobs         InstallJob[]
}
```

#### Thread
```prisma
model Thread {
  id              String      @id @default(cuid())
  customerId      String
  teamPageId      String
  status          String      @default("open") // "open" | "closed" | "escalated"
  lastMessageAt   DateTime    @default(now())
  createdAt       DateTime    @default(now())
  // Relations
  customer        Customer    @relation(fields: [customerId], references: [id])
  teamPage        TeamPage    @relation(fields: [teamPageId], references: [id])
  messages        Message[]
}
```

#### Message
```prisma
model Message {
  id              String      @id @default(cuid())
  threadId        String
  direction       String      // "inbound" | "outbound"
  body            String
  twilioSid       String?
  deliveryStatus  String?
  createdAt       DateTime    @default(now())
  // Relations
  thread          Thread      @relation(fields: [threadId], references: [id])
}
```

#### ChannelAssignment
```prisma
model ChannelAssignment {
  id          String      @id @default(cuid())
  teamPageId  String
  userId      String
  role        String      // "owner" | "team_member" | "worker"
  createdAt   DateTime    @default(now())
  // Relations
  teamPage    TeamPage    @relation(fields: [teamPageId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  worker      Worker?     @relation(fields: [userId], references: [userId])
}
```

#### ChannelPhoneNumber
```prisma
model ChannelPhoneNumber {
  id              String      @id @default(cuid())
  teamPageId      String
  phoneNumberId   String
  isActive        Boolean     @default(true)
  lastUsedAt      DateTime?
  createdAt       DateTime    @default(now())
  // Relations
  teamPage        TeamPage    @relation(fields: [teamPageId], references: [id])
  phoneNumber     PhoneNumber @relation(fields: [phoneNumberId], references: [id])
}
```

