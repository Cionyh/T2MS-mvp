generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  role          String?

  // Note: clients relation removed - clients now belong to organizations
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  stripeCustomerId String?
  state            String?
  country          String?
  businessCategory String?
  referralCode     String?       @map("referral_code")
  registeredFromSandbox Boolean   @default(false) @map("registered_from_sandbox")
  migratedToLiveAt      DateTime? @map("migrated_to_live_at")

  members      Member[]
  invitations  Invitation[]
  onboarding   Onboarding?
  customer     Customer?
  worker       Worker?
  couponRedemptions CouponRedemption[]
  referredBy   ReferralCode? @relation("UsersByReferralCode", fields: [referralCode], references: [code], onDelete: SetNull, onUpdate: Cascade)

  @@unique([email])
  @@map("user")
}

model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]   @relation("UsersByReferralCode")

  @@map("referral_code")
}

model CouponCode {
  id               String             @id @default(cuid())
  code             String             @unique
  plan             String
  durationInMonths Int
  usageLimit       Int
  isActive         Boolean            @default(true)
  expiresAt        DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  redemptions      CouponRedemption[]

  @@map("coupon_code")
}

model CouponRedemption {
  id                 String        @id @default(cuid())
  couponCodeId       String
  userId             String
  subscriptionId     String?       @unique
  redeemedAt         DateTime      @default(now())
  expiresAt          DateTime
  cancelledAt        DateTime?
  cancellationReason String?
  couponCode         CouponCode    @relation(fields: [couponCodeId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([couponCodeId])
  @@map("coupon_redemption")
}

model Customer {
  id                    String       @id @default(cuid())
  userId                String       @unique
  smsConsentConfirmedAt DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  installJobs           InstallJob[]

  @@map("customer")
}

model InstallJob {
  id                 String    @id @default(cuid())
  customerId         String
  clientId           String?   // site (Client) this install request is for
  platform           String
  installType        String    // "script" | "iframe"
  websiteUrls        String[]  @default([])
  preferredPlacement String?
  accessMethod       String
  accessCredentials  String?
  notes              String?
  status             String    @default("QUEUED")
  priority           Int       @default(0)
  assignedWorkerId  String?
  checklistCompleted      Boolean   @default(false)
  proofUploaded           Boolean   @default(false)
  htmlUpdatedConfirmed    Boolean   @default(false)
  htmlUpdatedConfirmedAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedWorker     Worker?   @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  proofs             Proof[]
  payouts            WorkerPayout[]

  @@map("install_job")
}

model Worker {
  id             String       @id @default(cuid())
  userId         String       @unique
  availability   String       @default("OFF_SHIFT")
  maxActiveJobs  Int          @default(2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedJobs   InstallJob[]
  payouts        WorkerPayout[]

  @@map("worker")
}

model Proof {
  id         String     @id @default(cuid())
  jobId      String
  type       String
  fileUrl    String
  fileSize   Int
  uploadedAt DateTime  @default(now())
  job        InstallJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("proof")
}

model WorkerPayout {
  id        String     @id @default(cuid())
  workerId  String
  jobId     String
  amount    Decimal
  status    String     @default("EARNED")
  createdAt DateTime   @default(now())
  paidAt    DateTime?
  worker    Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  job       InstallJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("worker_payout")
}

// Plan + add-on billing only. Install setup (URLs, platform, access, etc.) lives in Customer + InstallJob.
model Onboarding {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String    @default("free")
  installAddonSku      String?   // "standard" | "restricted" | null
  installAddonStatus   String?   // "paid" | "refunded" | "disputed" | null
  stripeSubscriptionId String?
  stripePaymentIntentId String?
  setupPath            String?   // "hosted_only" | "embed" — Version 1 two-path onboarding
  churchOrganizationName   String?
  churchVerificationStatus String?   // "pending" | "verified" | "rejected"
  churchVerifiedAt         DateTime?
  churchPriceLockedUntil   DateTime? // intro price lock (up to 3 years for early adopters)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("onboarding")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Client {
  id             String  @id @default(cuid())
  organizationId String? // Nullable - clients can exist without organization (for backward compatibility)
  name           String
  domain         String  @unique
  // SMS routing: unique per user; incoming SMS use "KEYWORD: message" to route to this site
  keyword        String? // e.g. BAKERY, MENU; stored uppercase; required for new registrations
  // phone field removed - now in PhoneNumber model

  // Defaults for messages
  defaultType         String? @default("banner") // fallback type if message.type not set
  defaultBgColor      String? @default("#222")
  defaultTextColor    String? @default("#fff")
  defaultFont         String? @default("sans-serif")
  defaultDismissAfter Int?    @default(5000) // milliseconds
  pinned              Boolean @default(false)

  // Widget configuration settings
  widgetConfig Json? @default("{}") // JSON object containing all widget customization settings

  // Version 1: public hosted announcement page (t2ms.live /p/{slug})
  hostedSlug        String?   @unique
  hostedEnabled     Boolean   @default(false)
  hostedIntroText   String?
  hostedFooterText  String?
  /// Public page layout: classic | light | spotlight | banner | minimal | aurora | stage
  hostedTheme       String    @default("classic")
  /// Whether to display hosted page logo (default on)
  hostedShowLogo    Boolean   @default(true)
  /// Show "Visit website" footer link (uses widgetConfig.companyWebsiteLink)
  hostedShowWebsiteLink Boolean @default(false)
  /// Announcement-page branding (independent of widgetConfig logo/background)
  hostedLogoUrl              String?
  hostedBackgroundImageUrl   String?
  /// Optional image shown under the announcement message
  hostedContentImageUrl      String?
  hostedPublishedAt DateTime?
  hostedWelcomeEmailSentAt DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  phoneNumbers PhoneNumber[]
  installJobs  InstallJob[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Inbound SMS to the affiliate Twilio number — not tied to Client or Message.
model AffiliateInboundSms {
  id        String   @id @default(cuid())
  fromPhone String
  toPhone   String
  body      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("affiliate_inbound_sms")
}

// Admin-managed Twilio destination numbers used by /api/twilio routing.
model InboundTwilioNumber {
  id              String   @id @default(cuid())
  phone           String
  normalizedPhone String   @unique
  label           String?
  purpose         String   @default("MAIN") // MAIN | AFFILIATE
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@map("inbound_twilio_number")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  source               String?   @default("stripe")
  couponCodeId         String?
  status               String?
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt             DateTime?
  seats                Int?
  updatedAt            DateTime?
  couponRedemption     CouponRedemption?

  @@map("subscription")
}

model PhoneNumber {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phone              String
  verified           Boolean   @default(false)
  verificationMethod String? // "OTP", "PIN", or "INVITE"
  pinCode            String? // 6-digit PIN code (legacy) or invite token
  pinExpiresAt       DateTime? // PIN expiration time or invite expiration
  invitedBy          String? // userId who invited this phone
  twilioVerifySid    String? // Twilio Verify Service SID for OTP verification
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Same phone can't be added twice to the same client; unique per (phone, client)
  @@unique([phone, clientId])
  @@map("phone_number")
}

// Note: Organization, Member, and Invitation tables will be created
// by running: npx @better-auth/cli migrate
// These tables are managed by Better Auth organization plugin

model Organization {
  id          String       @id
  name        String
  slug        String?
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  createdAt      DateTime
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}
